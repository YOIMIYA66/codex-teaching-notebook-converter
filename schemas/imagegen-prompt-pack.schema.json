{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YOIMIYA66/codex-teaching-notebook-converter/schemas/imagegen-prompt-pack.schema.json",
  "title": "Teaching Notebook Imagegen Prompt Pack",
  "type": "object",
  "required": ["version", "mode", "brand_references", "images"],
  "properties": {
    "version": {"const": 1},
    "mode": {"enum": ["quick", "standard", "full"]},
    "brand_references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "brand", "official_source_url", "local_file", "reference_sha256", "attribution", "usage_context"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "brand": {"type": "string", "minLength": 1},
          "official_source_url": {"type": "string", "pattern": "^https?://"},
          "local_file": {"type": "string", "minLength": 1},
          "reference_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "attribution": {"type": "string", "minLength": 1},
          "usage_context": {"type": "string", "minLength": 1}
        }
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "purpose",
          "information_goal",
          "density",
          "required_text",
          "source_locked_facts",
          "research_source_ids",
          "brand_reference_ids",
          "prompt",
          "negative_constraints",
          "output_file",
          "insertion_point",
          "status",
          "accepted_asset_sha256",
          "inspection",
          "repairs"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "information_goal": {"type": "string", "minLength": 1},
          "density": {
            "type": "object",
            "required": ["target", "information_regions", "text_items", "reading_path"],
            "properties": {
              "target": {"const": "moderately_high"},
              "information_regions": {"type": "integer", "minimum": 1},
              "text_items": {"type": "integer", "minimum": 1},
              "reading_path": {"type": "string", "minLength": 1}
            }
          },
          "required_text": {"type": "array", "items": {"type": "string"}},
          "source_locked_facts": {"type": "array", "items": {"type": "string"}},
          "research_source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "brand_reference_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "prompt": {"type": "string", "minLength": 1},
          "negative_constraints": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "output_file": {"type": "string", "minLength": 1},
          "insertion_point": {"type": "string", "minLength": 1},
          "status": {"enum": ["accepted", "repaired"]},
          "accepted_asset_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "inspection": {
            "type": "object",
            "required": ["text_accuracy", "numeric_accuracy", "readability", "information_density"],
            "properties": {
              "text_accuracy": {"const": "passed"},
              "numeric_accuracy": {"const": "passed"},
              "readability": {"const": "passed"},
              "information_density": {"const": "passed"},
              "brand_fidelity": {"const": "passed"}
            },
            "additionalProperties": {"enum": ["passed"]}
          },
          "repairs": {"type": "array"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
